# Generated by vpngw. Manual changes are made in the admin panel.
charon {
	load_modular = no
	load = random nonce openssl aes sha1 sha2 hmac gmp curve25519 pem pkcs1 pkcs8 x509 revocation constraints pubkey kdf {{if .KernelLibipsec}}kernel-libipsec{{end}} kernel-netlink socket-default vici eap-identity eap-radius attr counters
	port = 500
	port_nat_t = 4500
	install_routes = no
	install_virtual_ip = no
	ikesa_table_size = 1024
	ikesa_table_segments = 16
	reuse_ikesa = no
	make_before_break = yes
	send_vendor_id = no
	filelog {
		stderr {
			default = 1
			ike = 1
			cfg = 1
			time_format = %b %e %T
			ike_name = yes
		}
	}
	plugins {
		vici {
			socket = unix://{{.ViciSocket}}
		}
		eap-radius {
			nas_identifier = {{.NASIdentifier}}
			class_group = yes
			accounting = yes
			accounting_interval = 60
			station_id_with_port = no
			eap_start = no
			servers {
				vpngw {
					address = 127.0.0.1
					auth_port = {{.AuthPort}}
					acct_port = {{.AcctPort}}
					secret = {{.Secret}}
					sockets = 4
				}
			}
		}
	}
}
