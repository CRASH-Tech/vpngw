# Generated by vpngw. Manual changes are made in the admin panel.
auth = "radius[config={{.Dir}}/radiusclient.conf,groupconfig=true]"
acct = "radius[config={{.Dir}}/radiusclient.conf]"
stats-report-time = 60

# TCP arrives from the SNI router with PROXY protocol v2; DTLS directly.
listen-host = 127.0.0.1
tcp-port = {{.TCPPort}}
udp-listen-host = 0.0.0.0
udp-port = {{.UDPPort}}
listen-proxy-proto = true

run-as-user = nobody
run-as-group = nogroup
socket-file = {{.RunDir}}/ocserv.socket
occtl-socket-file = {{.RunDir}}/occtl.socket
use-occtl = true
pid-file = {{.RunDir}}/ocserv.pid
isolate-workers = true

server-cert = {{.CertFile}}
server-key = {{.KeyFile}}
tls-priorities = "NORMAL:%SERVER_PRECEDENCE:%COMPAT:-VERS-SSL3.0:-VERS-TLS1.0:-VERS-TLS1.1"

# Session limits are enforced by vpngw via RADIUS.
max-clients = 0
max-same-clients = 0
auth-timeout = 240
min-reauth-time = 3
max-ban-score = 0
cookie-timeout = 300
deny-roaming = false
rekey-time = 172800
rekey-method = ssl
keepalive = 32400
dpd = 90
mobile-dpd = 1800
switch-to-tcp-timeout = 25
try-mtu-discovery = true

device = vpns
predictable-ips = false
ipv4-network = {{.PoolNetwork}}
ipv4-netmask = {{.PoolNetmask}}
# DNS comes per session from vpngw (RADIUS): full-tunnel and vpnDomains logins.
tunnel-all-dns = false
ping-leases = false

cisco-client-compat = true
{{- if .ProfileFile}}
user-profile = {{.ProfileFile}}
{{- end}}
dtls-legacy = true
client-bypass-protocol = false
log-level = 1
