# Generated by vpngw. Manual changes are made in the admin panel.
# --- Connection ---
port {{.Port}}
{{- if eq .Proto "tcp"}}
proto tcp-server
{{- else}}
proto udp
multihome
{{- end}}
dev {{.Device}}
dev-type tun
topology subnet
tun-mtu {{.MTU}}
mssfix {{.MSS}}
push "tun-mtu {{.MTU}}"

# --- Server mode & network ---
server {{.PoolNetwork}} {{.PoolNetmask}}

# --- Cryptography ---
# {{.CertNote}}
ca {{.CAFile}}
cert {{.CertFile}}
key {{.KeyFile}}
{{- if .DHFile}}
dh {{.DHFile}}
{{- else}}
dh none
{{- end}}
tls-groups secp384r1:X25519:prime256v1
tls-version-min 1.2
data-ciphers AES-256-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-GCM
auth SHA256
# Per-client tls-crypt keys bound to the user (checked by vpngw).
tls-crypt-v2 {{.Dir}}/tls-crypt-v2-server.key
tls-crypt-v2-verify "{{.VerifyCommand}}"
script-security 2

# --- Authentication: username/password checked by vpngw ---
verify-client-cert none
username-as-common-name
duplicate-cn
management {{.ManagementSocket}} unix
management-client-auth
auth-gen-token 0 external-auth
auth-gen-token-secret {{.Dir}}/auth-token.key

# --- System ---
keepalive 10 120
{{- if ne .Proto "tcp"}}
explicit-exit-notify 1
{{- end}}
max-clients 4096
persist-key
verb 3
mute 20
