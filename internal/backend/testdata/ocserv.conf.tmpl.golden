# Generated by vpngw. Manual changes are made in the admin panel.
auth = "radius[config=/data/run/ocserv/radiusclient.conf,groupconfig=true]"
acct = "radius[config=/data/run/ocserv/radiusclient.conf]"
stats-report-time = 60

# TCP arrives from the SNI router with PROXY protocol v2; DTLS directly.
listen-host = 127.0.0.1
tcp-port = 4443
udp-listen-host = 0.0.0.0
udp-port = 443
listen-proxy-proto = true

run-as-user = nobody
run-as-group = nogroup
socket-file = /run/vpngw/ocserv/ocserv.socket
occtl-socket-file = /run/vpngw/ocserv/occtl.socket
use-occtl = true
pid-file = /run/vpngw/ocserv/ocserv.pid
isolate-workers = true

server-cert = /data/run/tls/server.crt
server-key = /data/run/tls/server.key
tls-priorities = "NORMAL:%SERVER_PRECEDENCE:%COMPAT:-VERS-SSL3.0:-VERS-TLS1.0:-VERS-TLS1.1"

# Session limits are enforced by vpngw via RADIUS.
max-clients = 0
max-same-clients = 0
auth-timeout = 240
min-reauth-time = 3
max-ban-score = 0
cookie-timeout = 300
deny-roaming = false
rekey-time = 172800
rekey-method = ssl
keepalive = 32400
dpd = 90
mobile-dpd = 1800
switch-to-tcp-timeout = 25
try-mtu-discovery = true

device = vpns
predictable-ips = false
ipv4-network = 10.250.0.0
ipv4-netmask = 255.255.240.0
# DNS comes per session from vpngw (RADIUS): full-tunnel and vpnDomains logins.
tunnel-all-dns = false
ping-leases = false

cisco-client-compat = true
user-profile = vpn.example.com.xml
dtls-legacy = true
client-bypass-protocol = false
log-level = 1
