# Generated by vpngw. Manual changes are made in the admin panel.
# --- Connection ---
port 1194
proto udp
multihome
dev vpngw-ovpn
dev-type tun
topology subnet
tun-mtu 1420
mssfix 1360
push "tun-mtu 1420"

# --- Server mode & network ---
server 10.250.16.0 255.255.240.0

# --- Cryptography ---
# certificate of the portal (Let's Encrypt), clients trust ISRG Root X1
ca /data/openvpn/ca.crt
cert /data/run/tls/server.crt
key /data/run/tls/server.key
dh /data/openvpn/dh.pem
tls-groups secp384r1:X25519:prime256v1
tls-version-min 1.2
data-ciphers AES-256-GCM:CHACHA20-POLY1305
data-ciphers-fallback AES-256-GCM
auth SHA256
# Per-client tls-crypt keys bound to the user (checked by vpngw).
tls-crypt-v2 /data/openvpn/tls-crypt-v2-server.key
tls-crypt-v2-verify "/usr/local/bin/vpngw tls-verify"
script-security 2

# --- Authentication: username/password checked by vpngw ---
verify-client-cert none
username-as-common-name
duplicate-cn
management /run/vpngw/openvpn.sock unix
management-client-auth
auth-gen-token 0 external-auth
auth-gen-token-secret /data/openvpn/auth-token.key

# --- System ---
keepalive 10 120
explicit-exit-notify 1
max-clients 4096
persist-key
verb 3
mute 20
